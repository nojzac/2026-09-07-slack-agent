# Secrets: ignore bare .env only, keep the 1Password reference file and non-secret config
.env
!.env.op
!config.env
op.env
*.op.env

# Big files and media (live on the Mini, see ASSETS.md)
media/
data/
*.sqlite
*.db
*.zip
*.mp3
*.mp4
*.mkv
*.mov
*.xlsx
*.jsonl

# Node / Vercel
node_modules/
.vercel/
*.log

# Local junk
.DS_Store
.venv*

# Private keys must never be committed. The GitHub App's .pem landed inside the
# repo during lesson 08 (2026-09-16) because it was saved next to the checkout;
# it was caught before staging. This is the backstop, not the control — the
# control is that secrets live in 1Password and never on disk here.
*.pem
*.p12
*.key
id_rsa*

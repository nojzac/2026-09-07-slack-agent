# 1Password references only. Resolve with: op run --env-file=.env.op -- <command>
# Vercel holds its own copy of the runtime values, set through the Vercel UI.
SLACK_SIGNING_SECRET=op://SlackAgentOS/2026-09-07-slack-agent/signing_secret
SLACK_BOT_TOKEN=op://SlackAgentOS/2026-09-07-slack-agent/bot_token
E2B_API_KEY=op://SlackAgentOS/2026-09-07-slack-agent/e2b_api_key
CLAUDE_CODE_OAUTH_TOKEN=op://SlackAgentOS/2026-09-07-slack-agent/claude_code_oauth_token
GITHUB_APP_PRIVATE_KEY=op://SlackAgentOS/2026-09-07-slack-agent/github_app_private_key
# Not secret, but kept here so local tooling gets the same values the function has.
GITHUB_APP_ID=4970890
GITHUB_INSTALLATION_ID=162319448
# Optional: powers the `exa` MCP server (see joestar-agent/README.md). Unset is
# fine — the sandbox just runs with `deepwiki` alone. Add an `exa_api_key`
# field to the vault item above if you want it locally too; Vercel Production
# already has its own copy, set directly in the Vercel UI.
EXA_API_KEY=op://SlackAgentOS/2026-09-07-slack-agent/exa_api_key
# Optional: powers the Codex CLI second-opinion reviewer (see
# joestar-agent/README.md). Unset is fine — the sandbox just runs without
# Codex configured. The value is the whole contents of a local
# ~/.codex/auth.json, produced by running `codex login`. Add a
# `codex_auth_json` field to the vault item above if you want it locally too.
# Not added to Vercel here — that is Noj's to set.
CODEX_AUTH_JSON=op://SlackAgentOS/2026-09-07-slack-agent/codex_auth_json
# Optional: names the git repo the bot uses as its long-term memory (owner/repo).
# The kill switch — unset means memory is off. Not secret, commented so it
# stays opt-in.
# AGENT_MEMORY_REPO=nojzac/joestar-memory

#!/bin/sh
# Run a command with the Slack secrets in its environment, using a 1Password
# service account scoped to the SlackAgentOS vault (read-only) — not the
# desktop app's whole-account session.
#
#   bin/with-secrets npm test
#
# The service account token lives in the macOS login Keychain, never in a file.
# Create it once with:
#   op service-account create slack-agent-ci --vault SlackAgentOS:read_items
#   security add-generic-password -a "$USER" -s op-slackagentos -w   # paste token
set -eu

token=$(security find-generic-password -a "$USER" -s op-slackagentos -w 2>/dev/null) || {
  echo "with-secrets: no service-account token in the Keychain (service: op-slackagentos)" >&2
  echo "see the comment at the top of $0" >&2
  exit 1
}

OP_SERVICE_ACCOUNT_TOKEN="$token" exec op run \
  --env-file="$(dirname "$0")/../.env.op" -- "$@"
